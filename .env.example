# Example placeholders only. Supply real secrets through the deployment environment.
DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME?schema=public"
SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="ICON — World of Tile"
ADMIN_SESSION_SECRET="replace-with-a-long-random-secret"
# Keep false for HTTPS. Set true only for temporary HTTP server/IP access.
ADMIN_ALLOW_INSECURE_HTTP="false"
ADMIN_BOOTSTRAP_NAME=""
ADMIN_BOOTSTRAP_EMAIL=""
ADMIN_BOOTSTRAP_PASSWORD=""
ADMIN_BOOTSTRAP_ROLE="SUPER_ADMIN"

# Transactional email through Resend (https://resend.com).
EMAIL_PROVIDER="disabled"
EMAIL_FROM="ICON World of Tile <catalogues@your-verified-domain.com>"
EMAIL_API_KEY=""
CATALOGUE_NOTIFICATION_EMAIL="admin@example.com"
